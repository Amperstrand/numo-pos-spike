# ─── Numo POS spike — environment variables ────────────────────────────
# Copy this file to `.env` and edit as needed. All values are optional for
# the local demo; only set NUMO_WEBHOOK_AUTH_KEY if you want to enforce
# authenticated webhooks (e.g. when exposing the receiver to the public
# internet or wiring up a real Numo terminal).

# SQLite database location (relative to project root).
DATABASE_URL="file:./db/custom.db"

# OPTIONAL: secret shared with Numo. When set, the webhook receiver at
# /api/webhooks/numo will reject requests whose Authorization header
# doesn't match. Numo sends either `Authorization: Bearer <key>` or
# `Authorization: <key>` (it's permissive about the prefix).
# NUMO_WEBHOOK_AUTH_KEY=""

# OPTIONAL: URL of the kitchen-service Socket.io mini-service. Defaults
# to http://localhost:3003 — only change if you're running the service
# on a different host / port.
# KITCHEN_SERVICE_URL="http://localhost:3003"
